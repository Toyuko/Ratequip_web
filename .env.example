# Demo mode (no external services required)
DEMO_MODE=true

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Preferred name in current Clerk docs (same whsec_ value as above)
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Platform admins (optional lockdown). Comma-separated emails that may hold
# full admin. When set, new accounts cannot become admin even if Clerk/DB
# metadata is mistyped — only listed existing accounts keep access.
# PLATFORM_ADMIN_EMAILS=you@example.com

# Neon Postgres
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_BUYER_PREMIUM=
STRIPE_PRICE_SUPPLIER_SILVER=
STRIPE_PRICE_SUPPLIER_GOLD=
STRIPE_PRICE_SUPPLIER_PLATINUM=
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_CREDITS_2000=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Resend (required for real transactional email; without it, sends log as [demo-email])
# 1) Create API key: https://resend.com/api-keys
# 2) Verify domain: https://resend.com/domains (or use onboarding@resend.dev for account-owner tests only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=RateQuip <noreply@ratequip.com>
# Ops inbox for claim/moderation alerts
OPS_EMAIL=ops@ratequip.com
# Optional: default recipient for `npm run email:test`
# EMAIL_TEST_TO=you@example.com

# Invite welcome reward economics (also editable in Admin → Invite welcome reward)
INVITE_WELCOME_CREDITS=250
INVITE_INVITER_REWARD_CREDITS=50
INVITE_FOUNDING_MEMBER_ENABLED=true

# ABN Lookup (Tier-1 AU registry). Free GUID from https://abr.business.gov.au/Tools/WebServices
# When unset, RateQuip falls back to the public ABN Lookup HTML search/detail pages.
ABR_GUID=
# ABN_LOOKUP_GUID=  # alias for ABR_GUID

# Organic Growth (v10.1) — keyed HMAC for private email hashes (never commit production secret)
OG_EMAIL_HMAC_SECRET=
